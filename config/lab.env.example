# Copy to config/lab.env, edit locally, NEVER commit it.
# Existing RHACM/MCE hub with Central Infrastructure Management; no hub is deployed.
CLUSTER_NAME=latitude-sno
BASE_DOMAIN=digitaldovey.com
RHACM_KUBECONFIG=
PULL_SECRET_FILE=private/pull-secret.json
SSH_PUBLIC_KEY_FILE=private/id_ed25519.pub
# Use: oc get clusterimagesets -o custom-columns=NAME:.metadata.name,IMAGE:.spec.releaseImage
CLUSTER_IMAGE_SET=

# AWS RHACM hub ingress: dedicated NLB for Assisted Installer image downloads.
# Set public Route53 hosted zone ID containing the hub image hostname, NOT the SNO domain.
AWS_REGION=ap-southeast-2
HUB_PUBLIC_ROUTE53_ZONE_ID=
IMAGE_NLB_SERVICE=router-nlb-test
# WARNING: If set to YES, provision converts an HTTPS iPXE URL to plaintext HTTP.
# Only use if Latitude firmware cannot validate the hub's TLS certificate.
LATITUDE_IPXE_FORCE_HTTP=NO

# Latitude project display name. Scripts resolve it to its project ID through the API.
# Alternatively specify the project ID (proj_...) or slug directly.
LATITUDE_PROJECT="Red Hat SSA Sandbox"
# Latitude Singapore site API code is SGP.
LATITUDE_SITE=SGP
# Provider API slug f4-metal-small corresponds to the f4.metal.small plan.
LATITUDE_PLAN=f4-metal-small
LATITUDE_HOSTNAME=latitude-sno

# Cloudflare Zone ID optional (automatically looked up by BASE_DOMAIN if blank).
CF_ZONE_ID=
# Export CF_API_TOKEN and LATITUDE_AUTH_TOKEN in your local shell; never commit tokens.

# Optional overrides. Normally populated automatically from Latitude's exact
# Terraform server and its management IP/CIDR (never guessed from the plan).
NODE_IP=
MACHINE_NETWORK_CIDR=
# Optional OS disk override. Default: lowest eligible stable NVMe by-id path;
# confirm the displayed choice before CONFIRM_INSTALL=YES.
INSTALL_DISK_ID=

# Optional: explicitly select the discovered Agent.
AGENT_ID=

# Post-install operators (only after SNO control plane is fully Ready).
# Optional: blank uses current oc context (must be the NEW SNO, not RHACM).
SNO_KUBECONFIG=
# Optional: discovers the single unused, signature-free whole NVMe on SNO.
# Always requires CONFIRM_LVMS_DISK=YES before allocation.
LVMS_DISK_BY_ID=
