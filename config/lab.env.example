# Copy to config/lab.env, edit locally, NEVER commit it.
# These values refer to an existing RHACM/MCE hub (no new hub deployed).
CLUSTER_NAME=latitude-sno
BASE_DOMAIN=example.com
RHACM_KUBECONFIG=
PULL_SECRET_FILE=private/pull-secret.json
SSH_PUBLIC_KEY_FILE=private/id_ed25519.pub
# Use: oc get clusterimagesets -o custom-columns=NAME:.metadata.name,IMAGE:.spec.releaseImage
CLUSTER_IMAGE_SET=

# Latitude account project (slug or ID), actual site code, and plan.
LATITUDE_PROJECT=
LATITUDE_SITE=
LATITUDE_PLAN=m4.metal.small
# A higher-headroom fallback is f4.metal.small (12 physical cores, 96GB).
# Set LATITUDE_AUTH_TOKEN in your shell or a local ignored file; never commit.
LATITUDE_HOSTNAME=latitude-sno

# Fill these in AFTER provisioning/discovery and BEFORE make install.
# Public address must remain stable through installation.
NODE_IP=
# Latitude's actual network CIDR containing NODE_IP (not 10.0.0.0/8).
MACHINE_NETWORK_CIDR=
# Agent inventory disk ID, NOT a guessed /dev/sdX path.
INSTALL_DISK_ID=

# Optional: set an Agent name explicitly if more than one is discovered.
AGENT_ID=
